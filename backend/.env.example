PORT=5000
CLIENT_URL=http://localhost:5173
# Sign-in link sent to users on WhatsApp (defaults to https://management.mopasltd.com/)
# LOGIN_URL=https://management.mopasltd.com/
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=job_management_system
JWT_SECRET=super-secret-key
JWT_EXPIRES_IN=7d
INIT_DB_ON_START=false
SEED_ADMIN_ON_START=true
DEFAULT_ADMIN_NAME=System Admin
DEFAULT_ADMIN_EMAIL=admin@jobmanagement.local
DEFAULT_ADMIN_PASSWORD=Admin12345!
UPLOADS_DIR=uploads

# Timezone that defines "today" for daily plans
APP_TIMEZONE=Africa/Kigali

# Accounts hidden from the "Ask for help" list (comma separated emails)
# MENTION_HIDDEN_EMAILS=admin@example.com
